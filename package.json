{
  "name": "mini-gradient-preview",
  "displayName": "Mini Gradient Preview",
  "publisher": "vickylab",
  "icon": "icon.png",
  "repository": {"type": "git","url": "https://github.com/Vicky-Raj/mini-gradient-preview"},
  "description": "An extension to help visualize css graidents in editor",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Gradient Preview",
      "properties": {
        "mini-gradient-preview.show": {
          "type": "boolean",
          "default": true,
          "description": "Whether to show gradient previews in the current workspace"
        },
        "mini-gradient-preview.size": {
          "type": "number",
          "default": 40,
          "description": "Size (width in pixels at standard font size) of the gradient preview box"
        },
        "mini-gradient-preview.borderColor": {
          "type": "string",
          "default": "white",
          "description": "Border color of the gradient preview box"
        },
        "mini-gradient-preview.boxShadow": {
          "type": "string",
          "default": "0 0 2px 1px rgba(0, 0, 0, 0.5)",
          "description": "Box shadow surrounding the gradient preview box"
        },
        "mini-gradient-preview.borderRadius": {
          "type": "string",
          "default": "33%",
          "description": "Border radius of the gradient preview box"
        },
        "mini-gradient-preview.fileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "css",
            "scss",
            "less",
            "html"
          ],
          "description": "List of file extensions or language IDs where gradient previews are enabled"
        }
      }
    },
    "commands": [
      {
        "command": "gradientpreview.showgradientpreviews",
        "title": "Show Gradient Previews"
      },
      {
        "command": "gradientpreview.hidegradientpreviews",
        "title": "Hide Gradient Previews"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.3",
    "@vscode/test-electron": "^2.2.0"
  }
}
